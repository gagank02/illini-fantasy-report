---
// Soccer style form guide: last N results as W/L/T badges, oldest to newest. The newest is outlined.
interface Props {
  record: string;
  n?: number;
}
const { record, n = 5 } = Astro.props;
const recent = [...record.slice(-n)];
const words = { W: 'win', L: 'loss', T: 'tie' } as Record<string, string>;
---

{recent.length > 0 && (
  <span class="form" role="img" aria-label={`Last ${recent.length}, oldest to newest: ${recent.map(c => words[c]).join(', ')}. Latest: ${words[recent.at(-1)!]}`}>
    {recent.map((c, i) => <span class:list={['f', `f-${c}`, { 'f-latest': i === recent.length - 1 }]} aria-hidden="true">{c}</span>)}
  </span>
)}
