---
// Rank change since last week: ▲ gained, ▼ dropped, - no change or no previous week.
interface Props {
  move: number | null;
}
const { move } = Astro.props;
---

{move === null || move === 0 ? (
  <span class="sub move">-<span class="visually-hidden">no change</span></span>
) : (
  <span class={`sub move ${move > 0 ? 'move-up' : 'move-down'}`}>
    {move > 0 ? '▲' : '▼'}{Math.abs(move)}
    <span class="visually-hidden">{move > 0 ? 'up' : 'down'} {Math.abs(move)} since last week</span>
  </span>
)}
