---
import Injury from '../components/Injury.astro';
import Ext from '../components/Ext.astro';
import Sparkline from '../components/Sparkline.astro';
import Base from '../layouts/Base.astro';
import players from '../data/players.json';
import { loadMomentum } from '../lib/fantasycalc';
import { loadSeason } from '../lib/sleeper';
import { standings, games, type Players } from '../lib/stats';
import { trendRows } from '../lib/trends';

const P = players as Players;
const { league, users, rosters, weeks } = await loadSeason();
const last = league.previous_league_id ? await loadSeason(league.previous_league_id) : null;
const lastSeason = last ? Number(last.league.season) : Number(league.season) - 1;
const ids = rosters.flatMap(r => r.players ?? []);
const loaded = loadMomentum(process.env, ids);
const rows = trendRows(rosters, P, weeks, last?.weeks ?? [], loaded?.momentum ?? {});

const teamName = new Map(standings(rosters, users, games(weeks)).map(r => [r.rosterId, r.team]));
const owner = new Map(rosters.flatMap(r => (r.players ?? []).map(id => [id, r.roster_id] as const)));
const fantasyTeam = (id: string) => teamName.get(owner.get(id)!) ?? '';
const pct = (v: number) => `${v > 0 ? '+' : ''}${Math.round(v * 100)}%`;
const fmt = (xs: (number | null)[]) => xs.map(v => (v === null ? '-' : v.toFixed(1))).join(', ');
const positions = ['All', 'QB', 'RB', 'WR', 'TE'];
---

<Base title="Trends">
  <h1>Trends</h1>
  <p class="muted">
    How every rostered player is doing this season. <strong>Last 2</strong> (<strong>Last 3</strong> from week 6) compares a player's most recent weeks with his weeks before them, so ▲ means heating up. <strong>Market</strong> is how much his trade value moved over the last 30 days. The {lastSeason} column is last season in this league, for comparison.
  </p>
  <p class="trade-credit">
    {loaded?.sample
      ? <>Market numbers are made up for local testing. Points from <Ext href="https://sleeper.com">Sleeper</Ext>.</>
      : loaded
        ? <>Market moves from <Ext href="https://fantasycalc.com">FantasyCalc.com</Ext>, updated {loaded.fetched}. Points from <Ext href="https://sleeper.com">Sleeper</Ext>.</>
        : <>Points from <Ext href="https://sleeper.com">Sleeper</Ext>. Market moves appear after the next daily update.</>}
  </p>

  <div class="trends">
    <fieldset class="tab-list">
      <legend class="visually-hidden">Position</legend>
      {positions.map((p, i) => (
        <>
          <input type="radio" name="trend-pos" id={`pos-${p}`} class="visually-hidden" checked={i === 0} />
          <label for={`pos-${p}`}>{p}</label>
        </>
      ))}
    </fieldset>

    <div class="table-scroll">
      <table class="trend-table">
        <thead>
          <tr>
            <th scope="col" class="left">Player</th>
            <th scope="col">{league.season} by week</th>
            <th scope="col">{league.season} avg</th>
            {loaded && <th scope="col" class="wide">Market, 30 days</th>}
            <th scope="col" class="wide">{lastSeason}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(r => (
            <tr data-pos={r.pos}>
              <th scope="row" class="left">
                {P[r.id]!.name}<Injury status={P[r.id]!.injury} body={P[r.id]!.body} />
                <span class="sub">{r.pos} {P[r.id]!.team ?? 'FA'} · {fantasyTeam(r.id)}</span>
                {(r.form !== null || (loaded && r.momentum !== null)) && (
                  <span class="sub narrow">
                    {r.form !== null && <span class={`move ${r.form >= 0 ? 'move-up' : 'move-down'}`}>Last {r.recentWeeks} {r.form >= 0 ? '▲' : '▼'}{Math.abs(r.form).toFixed(1)}</span>}
                    {r.form !== null && loaded && r.momentum !== null && ' · '}
                    {loaded && r.momentum !== null && <span class={`move ${r.momentum >= 0 ? 'move-up' : 'move-down'}`}>Market {r.momentum >= 0 ? '▲' : '▼'} {pct(r.momentum)}</span>}
                  </span>
                )}
              </th>
              <td>
                <Sparkline
                  series={r.s26}
                  label={`${P[r.id]!.name} ${league.season} points by week, average ${r.avg26?.toFixed(1) ?? 'none yet'}`}
                  tooltip={`${league.season}: ${fmt(r.s26)}`}
                />
              </td>
              <td>
                {r.avg26?.toFixed(1) ?? '-'}
                {r.form !== null && <span class={`sub wide move ${r.form >= 0 ? 'move-up' : 'move-down'}`}>Last {r.recentWeeks} {r.form >= 0 ? '▲' : '▼'}{Math.abs(r.form).toFixed(1)}</span>}
              </td>
              {loaded && (
                <td class="wide">{r.momentum === null ? '-' : <span class={`move ${r.momentum >= 0 ? 'move-up' : 'move-down'}`}>{r.momentum >= 0 ? '▲' : '▼'} {pct(r.momentum)}</span>}</td>
              )}
              <td class="wide last-season">
                {r.avg25 === null ? <span class="muted">Not in league</span> : (
                  <>
                    <Sparkline series={r.s25} width={80} height={24} label={`${P[r.id]!.name} ${lastSeason} points by week, average ${r.avg25.toFixed(1)}`} tooltip={`${lastSeason}: ${fmt(r.s25)}`} />
                    <span class="sub">{r.avg25.toFixed(1)} avg</span>
                  </>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <p class="muted legend">Last 2 and Last 3 need at least four weeks this season. Hover a line for every week's points. Gaps are weeks a player wasn't on a roster here. Kickers and defenses aren't included.</p>
</Base>
