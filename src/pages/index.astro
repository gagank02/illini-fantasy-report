---
import { getCollection } from 'astro:content';
import Facts from '../components/Facts.astro';
import Ext from '../components/Ext.astro';
import Form from '../components/Form.astro';
import Move from '../components/Move.astro';
import Sparkline from '../components/Sparkline.astro';
import players from '../data/players.json';
import { loadMomentum } from '../lib/fantasycalc';
import { loadNflverse } from '../lib/nflverse';
import Base from '../layouts/Base.astro';
import { loadSeason } from '../lib/sleeper';
import { facts, games, powerRankings, scheduleLuck, standings, whatIfMatrix, type Players } from '../lib/stats';
import { heatingUp, marketMover, trendRows } from '../lib/trends';

const { league, users, rosters, weeks } = await loadSeason();
const all = games(weeks);
const rows = standings(rosters, users, all);
const team = (id: number) => rows.find(r => r.rosterId === id)!;
const power = powerRankings(all, weeks.length);
const riser = power.filter(p => (p.move ?? 0) > 0).sort((a, b) => b.move! - a.move!)[0];
const luck = scheduleLuck(whatIfMatrix(rows, all));
const [luckiest, unluckiest] = [luck[0], luck.at(-1)];
const latest = (await getCollection('reports')).sort((a, b) => b.data.season - a.data.season || b.data.week - a.data.week)[0];
// Trends card: real points (other weeks from nflverse once saved), plus FantasyCalc momentum once the daily job has saved it.
const P = players as Players;
const last = league.previous_league_id ? await loadSeason(league.previous_league_id) : null;
const momentum = loadMomentum(process.env, rosters.flatMap(r => r.players ?? []));
const nfl = loadNflverse(Number(league.season));
const trendList = trendRows(rosters, P, weeks, last?.weeks ?? [], momentum?.momentum ?? {}, nfl ?? undefined);
const hot = heatingUp(trendList);
const mover = marketMover(trendList);
const rec = (id: number) => { const r = team(id); return `${r.w}-${r.l}${r.t ? `-${r.t}` : ''}`; };
---

<Base>
  <h1>Week {weeks.length} in the Illini Fantasy league</h1>
  <p class="muted">{league.season} season. Tap any card for the full page.</p>

  {weeks.length === 0 ? (
    <p>No games are final yet. Check back after week 1.</p>
  ) : (
    <>
      {latest && (
        <a class="lead-story" href={`/reports/${latest.id}`}>
          <span class="fact-title">This week's report, {latest.data.season} week {latest.data.week}</span>
          <h2>{latest.data.headline}</h2>
          <p>{latest.data.lede}</p>
          <span class="pv-more">Read the full report →</span>
        </a>
      )}

      <div class="previews">
        <a class="preview" href="/standings">
          <h2>Standings</h2>
          <ol role="list">
            {rows.slice(0, 3).map(r => (
              <li><span class="pv-rank">{r.rank}</span><span>{r.team}</span><span class="pv-num">{r.w}-{r.l}{r.t ? `-${r.t}` : ''}</span></li>
            ))}
          </ol>
          <span class="pv-more">Full standings →</span>
        </a>

        <a class="preview" href="/power-rankings">
          <h2>Power Rankings</h2>
          <ol role="list">
            {power.slice(0, 3).map(p => (
              <li><span class="pv-rank">{p.rank}</span><span>{team(p.rosterId).team}</span><span class="pv-num">{p.score.toFixed(1)} <Move move={p.move} /></span></li>
            ))}
          </ol>
          {riser && <p class="pv-note">Biggest riser: <strong>{team(riser.rosterId).team}</strong>, up {riser.move}.</p>}
          <span class="pv-more">All rankings and positions →</span>
        </a>

        <a class="preview" href="/what-if">
          <h2>What If</h2>
          {luckiest && luckiest.luck > 0 && (
            <p class="pv-note">
              <span class="fact-title">Luckiest schedule</span>
              <strong>{team(luckiest.rosterId).team}</strong> is {rec(luckiest.rosterId)} but would average {luckiest.avgWins.toFixed(1)} wins across every schedule.
            </p>
          )}
          {unluckiest && unluckiest.luck < 0 && (
            <p class="pv-note">
              <span class="fact-title">Unluckiest schedule</span>
              <strong>{team(unluckiest.rosterId).team}</strong> is {rec(unluckiest.rosterId)} but would average {unluckiest.avgWins.toFixed(1)} wins across every schedule.
            </p>
          )}
          <span class="pv-more">Every team on every schedule →</span>
        </a>

        <a class="preview" href="/trends">
          <h2>Trends</h2>
          <span class="fact-title">Heating up this season</span>
          {hot.length ? (
            <ol role="list">
              {hot.map(r => (
                <li class="pv-trend">
                  <span>{P[r.id]!.name}</span>
                  <Sparkline series={r.s26} width={64} height={22} label={`${P[r.id]!.name} ${league.season} points by week`} tooltip={`Last ${r.recentWeeks} weeks ${r.recent!.toFixed(1)} a game, ${r.form! >= 0 ? 'up' : 'down'} ${Math.abs(r.form!).toFixed(1)} on the weeks before`} />
                  <span class={`pv-num move ${r.form! >= 0 ? 'move-up' : 'move-down'}`}>{r.form! >= 0 ? '▲' : '▼'}{Math.abs(r.form!).toFixed(1)}</span>
                </li>
              ))}
            </ol>
          ) : (
            <p class="pv-note">Check back after week 4.</p>
          )}
          {mover && (
            <p class="pv-note">
              Market mover: <strong>{P[mover.id]!.name}</strong>, {mover.momentum! >= 0 ? 'up' : 'down'} {Math.abs(Math.round(mover.momentum! * 100))}% in 30 days.
            </p>
          )}
          <span class="pv-more">Every player's trend →</span>
        </a>
      </div>
      <p class="trade-credit">
        {mover
          ? <>Market moves from <Ext href="https://fantasycalc.com">FantasyCalc.com</Ext>{momentum?.sample ? ' (made up for local testing)' : ''}. Points from <Ext href="https://sleeper.com">Sleeper</Ext>.</>
          : <>Scores and trends from <Ext href="https://sleeper.com">Sleeper</Ext>.</>}
        {nfl && <span> Other weeks from <Ext href="https://github.com/nflverse">nflverse</Ext> (<Ext href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</Ext>).</span>}
      </p>

      <Facts facts={facts(rows, all)} teamNames={rows.map(r => r.team)} />
    </>
  )}
</Base>
