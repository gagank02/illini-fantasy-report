---
import Injury from '../../components/Injury.astro';
import players from '../../data/players.json';
import Base from '../../layouts/Base.astro';
import { buildHistory, draftBoard, draftValue, loadHistory, playoffRounds, type SeasonData } from '../../lib/history';
import { draftPicks } from '../../lib/sleeper';
import { games, standings, teamNames, type Players } from '../../lib/stats';

export async function getStaticPaths() {
  const seasons = await loadHistory();
  return seasons.map(s => ({ params: { season: s.league.season }, props: { seasons, season: s } }));
}

const { seasons, season } = Astro.props as { seasons: SeasonData[]; season: SeasonData };
const summary = buildHistory(seasons).seasons.find(x => x.season === Number(season.league.season))!;
const team = (rosterId: number) => {
  const r = season.rosters.find(x => x.roster_id === rosterId);
  return r ? teamNames(season.users, r.owner_id).team : `Team ${rosterId}`;
};
const picks = await draftPicks(season.league.draft_id);
const board = picks.length ? draftBoard(picks, team) : null;
const value = picks.length ? draftValue(picks, season.weeks) : null;
const rank = new Map(standings(season.rosters, season.users, games(season.weeks)).map(r => [r.rosterId, r.rank]));
const bracket = season.bracket ? playoffRounds(season.bracket, team, season.playoffWeeks, id => rank.get(id)) : null;
// Games that feed one next round game are drawn as a pair, joined by a bracket line.
const groups = (i: number) => {
  const ms = bracket!.rounds[i]!.matches;
  const size = (bracket!.rounds[i + 1]?.matches.length ?? 0) * 2 === ms.length ? 2 : 1;
  return Array.from({ length: Math.ceil(ms.length / size) }, (_, g) => ms.slice(g * size, g * size + size));
};
const placeName = (p: number) => `${p}${p === 3 ? 'rd' : 'th'} place`;
const pts = (n: number | null) => (n === null ? '' : n.toFixed(2));
const rec = (r: { w: number; l: number; t: number }) => `${r.w}-${r.l}${r.t ? `-${r.t}` : ''}`;
// Injury status is today's, so it only means something for the season in progress.
const injury = (id: string) => (summary.inProgress ? (players as Players)[id] : undefined);
const others = seasons.map(s => s.league.season).filter(y => y !== season.league.season);
---

<Base title={`${summary.season} Season`}>
  <p class="muted"><a href="/history">League history</a> · {others.map((y, i) => <>{i ? ', ' : ''}<a href={`/history/${y}`}>{y}</a></>)}</p>
  <h1>{summary.season} Season</h1>
  {summary.inProgress ? (
    <p class="muted">In progress. Standings through week {season.weeks.length}.</p>
  ) : (
    <ul class="champs">
      <li>
        <span class="fact-title">Champion</span>
        <strong class="champ-name"><a href={`/history/${summary.season}/champion`}>{summary.champion?.name}</a></strong>
        <span class="sub">{summary.champion?.team}</span>
        <dl>
          <div><dt>Runner up</dt><dd>{summary.runnerUp?.name}</dd></div>
          <div><dt>Punishment</dt><dd>{summary.punishment?.name}</dd></div>
          <div><dt>Teams</dt><dd>{summary.teams}</dd></div>
        </dl>
      </li>
    </ul>
  )}

  <section aria-labelledby="st-h">
    <h2 id="st-h">{summary.inProgress ? 'Standings' : 'Final regular season standings'}</h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th scope="col">#</th><th scope="col" class="left">Team</th><th scope="col">W-L-T</th><th scope="col">PF</th><th scope="col" class="wide">PA</th></tr></thead>
        <tbody>
          {summary.standings.map(r => (
            <tr>
              <td>{r.rank}</td>
              <th scope="row" class="left">{r.team}<span class="sub">{r.name}</span></th>
              <td>{rec(r)}</td>
              <td>{r.pf.toFixed(2)}<span class="sub narrow">PA {r.pa.toFixed(2)}</span></td>
              <td class="wide">{r.pa.toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {bracket && (
    <section aria-labelledby="po-h">
      <h2 id="po-h">Playoffs</h2>
      <div class="bracket">
        {bracket.rounds.map((r, i) => (
          <div class="b-round">
            <h3>{r.label}</h3>
            <div class="b-col">
              {groups(i).map(g => (
                <div class:list={['b-group', { 'b-pair': g.length === 2 }]}>
                  {g.map(m => (
                    <div class="b-slot">
                      <div class="b-match">
                        {m.teams.map(t => <div class:list={['b-team', { win: t.won }]}><span class="b-name">{t.seed && <span class="b-seed"><span class="visually-hidden">Seed </span>{t.seed}</span>}{t.name}{t.won && <span class="visually-hidden"> (won)</span>}</span><span class="b-pts">{pts(t.points)}</span></div>)}
                      </div>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      {bracket.placements.length > 0 && (
        <div class="b-placements">
          {bracket.placements.map(m => (
            <div class="b-match">
              <span class="fact-title">{placeName(m.place!)}</span>
              {m.teams.map(t => <div class:list={['b-team', { win: t.won }]}><span class="b-name">{t.seed && <span class="b-seed"><span class="visually-hidden">Seed </span>{t.seed}</span>}{t.name}{t.won && <span class="visually-hidden"> (won)</span>}</span><span class="b-pts">{pts(t.points)}</span></div>)}
            </div>
          ))}
        </div>
      )}
    </section>
  )}

  {board && value && (
    <>
      <section aria-labelledby="dv-h" class="facts">
        <h2 id="dv-h">Draft hits and busts{summary.inProgress ? ' so far' : ''}</h2>
        <p class="muted">Each pick is compared within its position. QB20 means the 20th quarterback drafted. Points count only weeks on a roster in this league.</p>
        <div class="dv-grid">
          {[['Best picks', value.hits], ['Worst picks', value.busts]].map(([label, list]) => (
            <div>
              <h3>{label as string}</h3>
              <ol class="dv-list">
                {(list as typeof value.hits).map(x => (
                  <li>
                    <strong>{x.name}</strong> <span class="muted">{x.pos}, pick {x.pickNo} by {team(x.rosterId)}</span>
                    <span class="sub">Drafted as {x.pos}{x.posPick}, {summary.inProgress ? 'currently' : 'finished'} {x.pos}{x.posFinish} with {x.points.toFixed(1)} pts{summary.inProgress ? ' so far' : ''}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>

      <section aria-labelledby="db-h">
        <h2 id="db-h">Draft board</h2>
        <div class="grid-only table-scroll">
          <table class="draft">
            <thead><tr><th scope="col">Rd</th>{board.slots.map(t => <th scope="col">{t}</th>)}</tr></thead>
            <tbody>
              {board.rounds.map((row, i) => (
                <tr>
                  <th scope="row">{i + 1}<span class="dp-dir" aria-label={board.directions[i] === 'ltr' ? 'picks go left to right' : 'picks go right to left'}>{board.directions[i] === 'ltr' ? '→' : '←'}</span></th>
                  {row.map(c => <td class={`pos-${c.pos}`} title={`Pick ${c.pickNo}`}><span class="dp-name">{c.name}</span><span class="dp-pos">{c.pos} {c.nflTeam}<Injury status={injury(c.playerId)?.injury} body={injury(c.playerId)?.body} /></span><span class="dp-pick">{c.label}</span></td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="list-only whatif-list">
          {board.slots.map((t, s) => (
            <details>
              <summary>{t}<span class="sub">Draft slot {s + 1}</span></summary>
              <ul>
                {board.rounds.map((row, i) => <li class={`pos-${row[s]!.pos}`}><span><span class="dp-pick-m">{row[s]!.label}</span> {row[s]!.name}<Injury status={injury(row[s]!.playerId)?.injury} body={injury(row[s]!.playerId)?.body} /></span><strong>{row[s]!.pos}</strong></li>)}
              </ul>
            </details>
          ))}
        </div>
      </section>
    </>
  )}
</Base>
