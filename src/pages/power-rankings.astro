---
import Base from '../layouts/Base.astro';
import { loadSeason } from '../lib/sleeper';
import players from '../data/players.json';
import { games, positionPoints, positionRankings, POSITIONS, powerRankings, standings, type Players, type Record3 } from '../lib/stats';

const { league, users, rosters, weeks } = await loadSeason();
const all = games(weeks);
const names = standings(rosters, users, all);
const rows = powerRankings(all, weeks.length);
const team = (id: number) => names.find(r => r.rosterId === id)!;
const byPos = positionPoints(weeks, players as Players);
const tabs = ['Overall', ...POSITIONS];

const rec = (r: Record3) => `${r.w}-${r.l}${r.t ? `-${r.t}` : ''}`;
const pct = (r: Record3) => ((r.w + r.t / 2) / (r.w + r.l + r.t)).toFixed(3).replace(/^0/, '');
---

<Base title="Power Rankings">
  <h1>Power Rankings</h1>
  <p class="muted">
    {league.season} through week {weeks.length}. <strong>Vs. everyone</strong> is your record if you had played all {rows.length - 1} other teams every week,
    so a 150 point week counts as a win against everyone who scored less. It takes schedule luck out of the picture.
  </p>
  <p class="muted">
    Score out of 100: 50% vs. everyone win rate, 30% total points, 20% points over the last 3 weeks.
  </p>

  <div class="tabs">
    <fieldset class="tab-list">
      <legend class="visually-hidden">Ranking</legend>
      {tabs.map((t, i) => (
        <>
          <input type="radio" name="pr-tab" id={`tab-${t}`} class="visually-hidden" checked={i === 0} />
          <label for={`tab-${t}`}>{t}</label>
        </>
      ))}
    </fieldset>

  <div class="tab-panel table-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col" class="left">Team</th>
          <th scope="col">Score</th>
          <th scope="col" class="wide" title={`Your record if you had played all ${rows.length - 1} other teams every week`}>Vs. everyone</th>
          <th scope="col" class="wide">PF</th>
          <th scope="col" class="wide">Last 3</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(r => {
          const t = team(r.rosterId);
          return (
            <tr>
              <td>{r.rank}</td>
              <th scope="row" class="left">
                {t.team}
                <span class="sub">{t.manager}</span>
                <span class="sub narrow">Vs. everyone {rec(r.allPlay)} ({pct(r.allPlay)})</span>
              </th>
              <td>
                {r.score.toFixed(1)}
                {r.move === null || r.move === 0 ? (
                  <span class="sub move">–<span class="visually-hidden">no change</span></span>
                ) : (
                  <span class={`sub move ${r.move > 0 ? 'move-up' : 'move-down'}`}>
                    {r.move > 0 ? '▲' : '▼'}{Math.abs(r.move)}
                    <span class="visually-hidden">{r.move > 0 ? 'up' : 'down'} {Math.abs(r.move)} since last week</span>
                  </span>
                )}
              </td>
              <td class="wide">{rec(r.allPlay)} <span class="rk">{pct(r.allPlay)}</span></td>
              <td class="wide">{r.pf.toFixed(2)}</td>
              <td class="wide">{r.last3.toFixed(2)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  {POSITIONS.map(pos => (
    <div class="tab-panel table-scroll">
      <table>
        <caption class="visually-hidden">{pos} starter points</caption>
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col" class="left">Team</th>
            <th scope="col">{pos} pts</th>
            <th scope="col">Per week</th>
          </tr>
        </thead>
        <tbody>
          {positionRankings(byPos, pos).map(r => (
            <tr>
              <td>{r.rank}</td>
              <th scope="row" class="left">{team(r.rosterId).team}<span class="sub">{team(r.rosterId).manager}</span></th>
              <td>{r.points.toFixed(2)}</td>
              <td>{(r.points / weeks.length).toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))}
  </div>
  <p class="muted legend">Position tabs rank teams by points scored by their starters at that position. A WR in a flex spot counts as a WR.</p>
</Base>
