---
import Form from '../components/Form.astro';
import Base from '../layouts/Base.astro';
import { loadSeason } from '../lib/sleeper';
import { facts, games, ordinal, standings } from '../lib/stats';

const { league, users, rosters, weeks } = await loadSeason();
const all = games(weeks);
const rows = standings(rosters, users, all);
const notes = facts(rows, all);

/** Split a fact sentence so team names can be bolded. Longest names first so one name inside another can't split it. */
const names = rows.map(r => r.team).sort((a, b) => b.length - a.length);
const pattern = new RegExp(`(${names.map(n => n.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`);
const parts = (text: string) => text.split(pattern).filter(Boolean).map(p => ({ text: p, team: names.includes(p) }));
const fmt = (n: number) => n.toFixed(2);
---

<Base title="Standings">
  <h1>Standings</h1>
  <p class="muted">{league.season} season, through week {weeks.length}. Small numbers next to PF and PA rank each team in the league, 1st being the most points.</p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col" class="left">Team</th>
          <th scope="col">W-L-T</th>
          <th scope="col">PF</th>
          <th scope="col" class="wide">PA</th>
          <th scope="col" class="wide">Last 5</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(r => (
          <tr>
            <td>{r.rank}</td>
            <th scope="row" class="left">
              {r.team}
              <span class="sub">{r.manager}</span>
              <span class="sub narrow"><Form record={r.record} /></span>
            </th>
            <td>{r.w}-{r.l}-{r.t}</td>
            <td>{fmt(r.pf)} <span class="rk">{ordinal(r.pfRank)}</span><span class="sub narrow">PA {fmt(r.pa)} <span class="rk">{ordinal(r.paRank)}</span></span></td>
            <td class="wide">{fmt(r.pa)} <span class="rk">{ordinal(r.paRank)}</span></td>
            <td class="wide"><Form record={r.record} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {notes.length > 0 && (
    <section class="facts" aria-labelledby="facts-h">
      <h2 id="facts-h">Around the league</h2>
      <ul>
        {notes.map(f => (
          <li>
            <span class="fact-title">{f.title}</span>
            {parts(f.text).map(p => (p.team ? <strong>{p.text}</strong> : p.text))}
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
