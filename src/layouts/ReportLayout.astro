---
import Base from './Base.astro';
import '../styles/report.css';
import type { Matchup, User, Roster } from '../lib/sleeper';
import { teamNames } from '../lib/stats';

interface Props {
  headline: string;
  lede: string;
  season: number;
  week: number;
  date: Date;
  /** That week's matchups for the box score, if available. */
  matchups?: Matchup[];
  users: User[];
  rosters: Roster[];
}
const { headline, lede, season, week, date, matchups = [], users, rosters } = Astro.props;

const name = (rosterId: number) => {
  const r = rosters.find(x => x.roster_id === rosterId);
  return r ? teamNames(users, r.owner_id).team : `Team ${rosterId}`;
};
const games = Object.values(
  Object.groupBy(matchups.filter(m => m.matchup_id != null), m => String(m.matchup_id)),
).map(pair => [...pair!].sort((a, b) => b.points - a.points));
// Drop cap as a real element (not ::first-letter) so image export keeps it. Spread handles emoji.
const [first = '', ...rest] = [...lede];
const longDate = date.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title={`Week ${week}: ${headline}`}>
  <div class="report-actions">
    <button type="button" id="save-pdf">Save PDF</button>
    <button type="button" id="save-img" data-filename={`illini-report-${season}-week-${week}.png`}>Save image</button>
    <span id="save-status" class="muted" role="status"></span>
  </div>
  <article class="paper" id="report">
    <header class="masthead">
      <div class="mast-title" aria-hidden="true">The Illini Fantasy Report</div>
      <div class="dateline">
        <span>Vol. {season}, No. {week}</span>
        <time datetime={date.toISOString().slice(0, 10)}>{longDate}</time>
        <span>Week {week} edition</span>
      </div>
    </header>

    <h1 class="headline">{headline}</h1>
    <p class="lede"><span class="dropcap" aria-hidden="true">{first}</span><span class="visually-hidden">{first}</span>{rest.join('')}</p>

    <div class="paper-body">
      <div class="columns">
        <slot />
      </div>
      {games.length > 0 && (
        <aside class="boxscore" aria-labelledby="box-h">
          <h2 id="box-h">Box Score</h2>
          <table>
            {games.map(([w, l]) => (
              <tbody>
                <tr class="win"><th scope="row" class="left">{name(w!.roster_id)}</th><td>{w!.points.toFixed(2)}</td></tr>
                {l && <tr><th scope="row" class="left">{name(l.roster_id)}</th><td>{l.points.toFixed(2)}</td></tr>}
              </tbody>
            ))}
          </table>
        </aside>
      )}
    </div>
    <p class="credit">League data, injuries, and trending players from Sleeper. Written with Claude from those facts.</p>
  </article>
</Base>

<script>
  document.getElementById('save-pdf')!.addEventListener('click', () => window.print());

  const imgButton = document.getElementById('save-img') as HTMLButtonElement;
  const status = document.getElementById('save-status')!;
  imgButton.addEventListener('click', async () => {
    imgButton.disabled = true;
    status.textContent = 'Making image…';
    // Render a copy off screen at a fixed 1080px newspaper layout so every device makes the same image.
    const holder = document.createElement('div');
    holder.className = 'capture-holder';
    const copy = document.getElementById('report')!.cloneNode(true) as HTMLElement;
    copy.removeAttribute('id');
    copy.classList.add('capture');
    holder.append(copy);
    document.body.append(holder);
    try {
      const { toPng } = await import('html-to-image');
      await document.fonts.ready;
      const url = await toPng(copy, { width: 1080, pixelRatio: 1, cacheBust: true });
      const a = document.createElement('a');
      a.href = url;
      a.download = imgButton.dataset.filename!;
      a.click();
      status.textContent = '';
    } catch (err) {
      console.error(err);
      status.textContent = 'Could not make the image. Try Save PDF instead.';
    } finally {
      holder.remove();
      imgButton.disabled = false;
    }
  });
</script>
